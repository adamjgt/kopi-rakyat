# Salin ke `.env` lalu sesuaikan.
#
# Migrasi ke Supabase asli (PRD Bagian 16) = cukup ganti DATABASE_URL di bawah,
# tidak ada perubahan kode. Ambil dari Supabase Dashboard >
# Project Settings > Database > Connection string (URI), mode "Session".

# --- Koneksi database ---------------------------------------------------
DATABASE_URL=postgresql://kopi:kopi@localhost:5433/kopi_rakyat
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# --- Realtime -----------------------------------------------------------
# notify = PostgreSQL LISTEN/NOTIFY (default, butuh trigger dari schema.sql)
# poll   = fallback polling bila LISTEN/NOTIFY sulit disiapkan
REALTIME_MODE=notify
REALTIME_CHANNEL=pos_order_events
POLL_INTERVAL_SECONDS=1.0

# --- Aplikasi -----------------------------------------------------------
# false = endpoint POST /api/dev/simulate-order dinonaktifkan (target produksi)
ENABLE_DEV_ENDPOINTS=true
CORS_ORIGINS=*
LOG_LEVEL=INFO
