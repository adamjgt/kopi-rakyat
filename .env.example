# Salin ke `.env` lalu sesuaikan.
#
# ── Menyambung ke Supabase ASLI ────────────────────────────────────────
# Cukup ganti DATABASE_URL. Ambil dari Supabase Dashboard >
# Project Settings > Database > Connection string (URI), mode "Session".
# Gunakan role `postgres` (bukan anon/authenticated) supaya backend bisa
# membaca semua order lintas user & mengeset klaim JWT saat memanggil RPC.
#
#   DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<ref>.supabase.co:5432/postgres
#
# Lalu pasang trigger realtime SEKALI di Supabase (SQL Editor): tempel isi
# db/realtime.sql. (Hanya perlu bila REALTIME_MODE=notify.)

# --- Koneksi database ---------------------------------------------------
# Default di bawah = Postgres LOKAL via docker compose (mirror skema asli).
DATABASE_URL=postgresql://kopi:kopi@localhost:5433/kopi_rakyat
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# --- Realtime -----------------------------------------------------------
# notify = PostgreSQL LISTEN/NOTIFY (butuh db/realtime.sql terpasang di DB)
# poll   = fallback tanpa trigger (bandingkan snapshot stage/status tiap interval)
REALTIME_MODE=notify
REALTIME_CHANNEL=pos_order_events
POLL_INTERVAL_SECONDS=1.0

# --- Aplikasi -----------------------------------------------------------
# false = /api/dev/* TIDAK didaftarkan. Mobile app memanggil place_order()
# langsung ke Supabase, jadi endpoint dev tidak dibutuhkan di produksi.
ENABLE_DEV_ENDPOINTS=false
CORS_ORIGINS=*
LOG_LEVEL=INFO
